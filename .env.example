# ==============================================================================
# Financial AI Operator - Environment Configuration Template
# Copy this file to .env for local configuration:
#     cp .env.example .env
# Never commit real credentials or API keys to version control.
#
# Production architecture:
#   Browser -> Next.js (frontend + BFF) -> FastAPI backend -> PostgreSQL
# Authenticated browser calls go through the Next.js BFF (/api/v1/*) which
# injects the HttpOnly session cookie as a Bearer token. Direct browser ->
# backend calls carry no session and are only used for unauthenticated probes.
# ==============================================================================

# Application Environment (development, test, production)
APP_ENV=development
APP_NAME=Financial AI Operator
APP_VERSION=0.1.0
DEBUG=true

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1

# Allowed browser origins for direct CORS requests (JSON array or CSV).
# In production this MUST be the real frontend origin (https://your-domain.com).
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration
# Local development defaults to SQLite (aiosqlite). For production use
# PostgreSQL with asyncpg (async) / psycopg2 (sync migrations).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finops_db
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/finops_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Frontend / BFF Configuration (apps/web)
# NEXT_PUBLIC_API_BASE_URL: browser-visible backend base; only used for
#   unauthenticated probes. All authenticated traffic proxies through the BFF.
# BACKEND_INTERNAL_URL: server-side (BFF) base used to reach FastAPI. Set both
#   to the internal backend URL in production.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
BACKEND_INTERNAL_URL=http://localhost:8000

# LLM / Investigation configuration
# LLM_PROVIDER: gemini (real Gemini) or mock (deterministic in-process fallback).
#   The mock provider is clearly labeled and never poses as a real LLM result.
# LLM_API_KEY: real provider credential. Leave empty when using LLM_PROVIDER=mock.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# JWT / Session Configuration
# JWT_SECRET_KEY is the ONLY authentication secret. It is also used to derive
# the Fernet key that encrypts TOTP/MFA secrets at rest, so changing it after
# users enroll in MFA invalidates stored MFA secrets. In production set a long
# random value (e.g. `openssl rand -hex 32`) — a predictable key aborts startup.
JWT_SECRET_KEY=dev-secret-key-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=20
JWT_ISSUER=financial-ai-operator
JWT_AUDIENCE=financial-ai-operator-api

# ------------------------------------------------------------------------------
# Not required as environment variables (resolved from the above at runtime):
#   - MFA TOTP secret encryption key  -> derived from JWT_SECRET_KEY
#   - MFA challenge token lifetime    -> ACCESS_TOKEN_EXPIRE_MINUTES
#   - BFF session cookie lifetime     -> ACCESS_TOKEN_EXPIRE_MINUTES
# ------------------------------------------------------------------------------
