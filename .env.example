# ==============================================================================
# Financial AI Operator - Environment Configuration Template
# Copy this file to .env for local configuration.
# Never commit real credentials or API keys to version control.
# ==============================================================================

# Application Environment (development, test, staging, production)
APP_ENV=development
APP_NAME=Financial AI Operator
APP_VERSION=0.1.0
DEBUG=true

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL with asyncpg for async, psycopg2 for sync/migrations)
# Default fallback to aiosqlite for seamless local development if Postgres is not active
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finops_db
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/finops_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
